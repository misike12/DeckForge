<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      net10.0-windows, not net10.0: §28.3's drag budget has two halves, and one of them is WPF
      arranging and drawing five hundred tiles. Measuring it needs PresentationFramework, and a plain
      net10.0 project does not reference it - the probe that proved it is CanvasPerformanceBudgetTests'
      own fixture check. So the test host is retargeted rather than the measurement faked.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!--
      NU1701, and only NU1701: WPF-UI 4.3.0 publishes no net10.0 asset, so NuGet restored its .NET
      Framework one and warned that the package "may not be fully compatible". It is. These tests
      compile against Wpf.Ui.Controls, read SymbolRegular out of it by reflection, and load Wpf.Ui.dll
      from beside the test assembly to check glyph names; all of that worked. The warning was about
      target-framework matching, not about the library, and there is no newer WPF-UI to move to.
      Retargeting to net10.0-windows (above) is what removes the mismatch, so the suppression is now
      belt-and-braces: kept because a stale comment in a build file is worse than a dead NoWarn.
    -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Setting UseWPF swaps the SDK's implicit-using set for the WindowsDesktop one, which drops
      System.IO and System.Net.Http. They are named back here rather than added to forty test files,
      so retargeting the host did not have to touch a single existing test source.
    -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MacroDeck.Ui" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeckForge.Core\DeckForge.Core.csproj" />
    <ProjectReference Include="..\..\src\DeckForge.CodeGen\DeckForge.CodeGen.csproj" />
    <ProjectReference Include="..\..\src\DeckForge.Validators\DeckForge.Validators.csproj" />
    <ProjectReference Include="..\..\src\DeckForge.CliAdapter\DeckForge.CliAdapter.csproj" />
    <!--
      The sample extension is referenced so the test can name the type it returns, and loaded from
      disk by path so it still goes through the real Assembly.LoadFrom discovery path. It lives in
      extensions/ and references only DeckForge.Core, so if it compiles at all the extension contract
      is satisfiable from outside the app's source tree.
    -->
    <ProjectReference Include="..\..\extensions\DeckForge.SampleExtension\DeckForge.SampleExtension.csproj" />
  </ItemGroup>

</Project>
