<ui:FluentWindow x:Class="DeckForge.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DeckForge"
                 Icon="pack://application:,,,/Assets/app-icon.png"
                 Width="1280" Height="800"
                 MinWidth="960" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DeckForge" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView Grid.Column="0"
                               x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               OpenPaneLength="220">

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Home" Tag="home" Icon="{ui:SymbolIcon Home24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="New Plugin" Tag="new-project" Icon="{ui:SymbolIcon AddCircle24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Capabilities" Tag="capabilities" Icon="{ui:SymbolIcon Grid24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Explorer" Tag="explorer" Icon="{ui:SymbolIcon Folder24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Manifest" Tag="manifest" Icon="{ui:SymbolIcon Info24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Actions" Tag="actions" Icon="{ui:SymbolIcon PlayCircle24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Events" Tag="events" Icon="{ui:SymbolIcon Megaphone24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Setup Flow" Tag="configflow" Icon="{ui:SymbolIcon Flowchart24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Blocks" Tag="blocks" Icon="{ui:SymbolIcon PuzzlePiece24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Widget Designer" Tag="widget" Icon="{ui:SymbolIcon Fingerprint24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Icon Studio" Tag="icons" Icon="{ui:SymbolIcon Color20}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Icon Packs" Tag="iconpack" Icon="{ui:SymbolIcon Apps24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Localization" Tag="localization" Icon="{ui:SymbolIcon Translate24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Build &amp; Run" Tag="buildrun" Icon="{ui:SymbolIcon Play24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Ship" Tag="ship" Icon="{ui:SymbolIcon Send24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Publish" Tag="publish" Icon="{ui:SymbolIcon Cloud24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Terminal" Tag="terminal" Icon="{ui:SymbolIcon Keyboard24}" Click="Nav_Click" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Docs" Tag="docs" Icon="{ui:SymbolIcon Book24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Extensions" Tag="extensions" Icon="{ui:SymbolIcon Puzzle24}" Click="Nav_Click" />
                    <ui:NavigationViewItem Content="Settings" Tag="settings" Icon="{ui:SymbolIcon Settings24}" Click="Nav_Click" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--
                    Handled crashes. The dispatcher handler swallows the first few so one bad page
                    does not close the app, but it used to do so in silence - the only record was a
                    file nobody had opened, and the UI carried on in whatever state it was left in.
                -->
                <Border x:Name="CrashBanner"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource Liquid.WarningBrush}"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DeckForge recovered from an error"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock x:Name="CrashDetail" FontSize="12" Foreground="White"
                                       TextWrapping="Wrap" MaxHeight="70" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Dismiss" Margin="12,0,0,0"
                                   Click="CrashBanner_Close" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Frame Grid.Row="1"
                       x:Name="PageHost"
                       Focusable="False"
                       NavigationUIVisibility="Hidden"
                       JournalOwnership="OwnsJournal"
                       Background="Transparent" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
