<Page x:Class="DeckForge.App.Pages.IconStudioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Icon Studio" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Design the plugin icon (Assets/icon.svg). The manifest's icon path is the single source of truth - the host reads this file directly."
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Docs → Button icons" Icon="{ui:SymbolIcon Book24}"
                           VerticalAlignment="Top" Margin="16,0,0,0"
                           Click="OpenDocs_Click" ToolTip="Open the Macro Deck icon documentation" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{DynamicResource Liquid.AccentStrongBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Editor -->
            <Border Grid.Column="0" Style="{StaticResource LiquidCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Template" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding Templates}"
                                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13" Padding="4,2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Shape color (hex)" FontSize="12" Margin="0,16,0,4" />
                        <ui:TextBox Text="{Binding ShapeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Accent color (hex)" FontSize="12" Margin="0,10,0,4" />
                        <ui:TextBox Text="{Binding AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Initials (for the Initial template)" FontSize="12" Margin="0,10,0,4" />
                        <ui:TextBox Text="{Binding IconText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="3" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <ui:Button Content="Save to workspace" Appearance="Primary"
                                       Command="{Binding SaveToWorkspaceCommand}" />
                            <ui:Button Content="Save as..." Margin="8,0,0,0"
                                       Command="{Binding SaveAsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview: the icon at deck sizes -->
            <Border Grid.Column="2" Style="{StaticResource LiquidCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Preview (144 px and 64 px tiles)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="144" Height="144" CornerRadius="16"
                                Background="#181A20" BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <wv2:WebView2 x:Name="PreviewLarge" DefaultBackgroundColor="Transparent" />
                        </Border>
                        <Border Width="64" Height="64" CornerRadius="8" Margin="16,0,0,0"
                                Background="#181A20" BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <wv2:WebView2 x:Name="PreviewSmall" DefaultBackgroundColor="Transparent" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
