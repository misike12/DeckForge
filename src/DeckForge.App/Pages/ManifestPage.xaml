<Page x:Class="DeckForge.App.Pages.ManifestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="40,24,40,24">
        <!-- Empty state -->
        <Border Background="{DynamicResource Liquid.AcrylicBrush}"
                BorderBrush="{DynamicResource Liquid.BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24"
                VerticalAlignment="Top"
                Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel>
                <ui:SymbolIcon Symbol="Info24" FontSize="28" />
                <TextBlock Text="No workspace open"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,8,0,4" />
                <TextBlock Text="Create or open a plugin first - Manifest Studio edits the manifest.json of the open workspace."
                           Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Go to Home" Appearance="Primary" Margin="0,0,8,0"
                               Click="GoHome_Click" />
                    <ui:Button Content="Docs → Manifest reference" Click="OpenDocs_Click"
                               ToolTip="Open the manifest.json reference" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Editor -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid MaxWidth="1100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3" Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Manifest Studio" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ManifestPath}"
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Left: fields -->
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Identity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TextBlock Text="Id (permanent)" FontSize="12" Margin="0,0,0,2" />
                    <ui:TextBox Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Name" FontSize="12" Margin="0,10,0,2" />
                    <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Version (SemVer)" FontSize="12" Margin="0,10,0,2" />
                    <ui:TextBox Text="{Binding Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Description" FontSize="12" Margin="0,10,0,2" />
                    <ui:TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="What the plugin does - shown in the Store." />

                    <TextBlock Text="Icon path" FontSize="12" Margin="0,10,0,2" />
                    <ui:TextBox Text="{Binding IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Publication" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />

                    <TextBlock Text="Publisher" FontSize="12" Margin="0,0,0,2" />
                    <ui:TextBox Text="{Binding Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="License (SPDX)" FontSize="12" Margin="0,10,0,2" />
                    <ui:TextBox Text="{Binding License, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Repository" FontSize="12" Margin="0,10,0,2" />
                    <ui:TextBox Text="{Binding Repository, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Homepage" FontSize="12" Margin="0,10,0,2" />
                    <ui:TextBox Text="{Binding Homepage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Compatibility" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
                    <TextBlock Text="Macro Deck version range" FontSize="12" Margin="0,0,0,2" />
                    <ui:TextBox Text="{Binding MacroDeckRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Platforms (entrypoints)" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8" />
                    <ItemsControl ItemsSource="{Binding Platforms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Liquid.AccentWashBrush}"
                                        CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Right: permissions (grouped + explained), validation, actions -->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Permissions" FontSize="16" FontWeight="SemiBold" />
                        <ui:Button Grid.Column="1" Content="Docs → Manifest" Margin="8,0,0,0" Padding="8,2"
                                   Click="OpenDocs_Click" ToolTip="Open the manifest reference (permissions section)" />
                    </Grid>
                    <TextBlock Text="Grouped as in the manifest reference. Only host:adb is enforced by the host; everything else is a declaration shown to the user in Macro Deck."
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource Liquid.AcrylicBrush}"
                            BorderBrush="{DynamicResource Liquid.BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12" MaxHeight="420">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PermissionGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,10">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Fill="{Binding GroupBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding CountLabel, FallbackValue=''}" FontSize="11.5" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                                                           Margin="14,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Rows}" Margin="14,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2">
                                                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                                          Click="Permission_Click"
                                                                          ToolTip="{Binding Explanation}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                                                        <TextBlock Text="  custom" FontSize="11" FontStyle="Italic"
                                                                                   Foreground="{DynamicResource Liquid.WarningBrush}"
                                                                                   Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                                <TextBlock Text="{Binding Explanation}" FontSize="11.5" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                                                           Margin="22,0,0,2" MaxWidth="330"
                                                                           Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="Validation" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8" />
                    <Border Background="{DynamicResource Liquid.AcrylicBrush}"
                            BorderBrush="{DynamicResource Liquid.BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12" MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding ValidationSummary}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                           Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Padding="8,6" CornerRadius="6"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                                        <Run Text="{Binding Code, Mode=OneWay}" />
                                                        <Run Text=" - " />
                                                        <Run Text="{Binding Severity, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Text="{Binding Message}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                                   Command="{Binding SaveCommand}" />
                        <ui:Button Content="Reload" Margin="8,0,0,0"
                                   Command="{Binding ReloadFromDiskCommand}" />
                        <TextBlock Text="{Binding SaveStatus}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Liquid.SuccessBrush}" FontSize="12" />
                        <TextBlock Text="unsaved changes"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Liquid.WarningBrush}" FontSize="12"
                                   FontStyle="Italic"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <!--
                        The manifest the host actually reads, after every field above has been
                        applied. It was recomputed on each keystroke and never shown anywhere, so a
                        field that did not round-trip - a lost key, a re-ordered list - was
                        invisible until a build failed against the real CLI.
                    -->
                    <Expander Header="manifest.json" Margin="0,12,0,0"
                              IsExpanded="False">
                        <TextBox Text="{Binding RawJson, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 MaxHeight="320"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
