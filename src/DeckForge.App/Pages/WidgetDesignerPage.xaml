<Page x:Class="DeckForge.App.Pages.WidgetDesignerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:vm="clr-namespace:DeckForge.App.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Widget designer" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Design a deck widget type: node palette, reorderable tree, per-node events, JSON Schema builder, a two-region editor (widget vs config surface) and a live 144px preview. Generates IWidgetTypeProvider + IUiProvider."
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource Liquid.AccentStrongBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Docs → Widget types" Icon="{ui:SymbolIcon Book24}"
                           VerticalAlignment="Top" Margin="16,0,0,0"
                           Click="OpenDocs_Click" ToolTip="Open the Macro Deck widget-types documentation" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- Palette + identity -->
            <Border Grid.Column="0" Style="{StaticResource LiquidCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Widget type" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="Type id (kebab)" FontSize="11.5" />
                        <ui:TextBox Text="{Binding WidgetTypeId, Mode=TwoWay}" />
                        <TextBlock Text="Name" FontSize="11.5" Margin="0,8,0,0" />
                        <ui:TextBox Text="{Binding WidgetName, Mode=TwoWay}" />
                        <TextBlock Text="Unit (default data)" FontSize="11.5" Margin="0,8,0,0" />
                        <ui:TextBox Text="{Binding Unit, Mode=TwoWay}" />
                        <CheckBox Content="Has configuration" IsChecked="{Binding HasConfiguration}" Margin="0,8,0,0" />
                        <CheckBox Content="Supports flows" IsChecked="{Binding SupportsFlows}" Margin="0,4,0,0" />
                        <Separator Margin="0,12" />
                        <TextBlock Text="Add node" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl x:Name="PaletteList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Tree + region switch -->
            <Border Grid.Column="2" Style="{StaticResource LiquidCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Node tree" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Widget surface" GroupName="region"
                                         IsChecked="{Binding EditingConfigRegion, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,10,0" />
                            <RadioButton Content="Config surface" GroupName="region"
                                         IsChecked="{Binding EditingConfigRegion}" />
                        </StackPanel>
                    </StackPanel>
                    <TreeView ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              Background="Transparent" BorderThickness="0" FontSize="12.5">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:WidgetNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Describe}" />
                                    <Button Content="↑" FontSize="10" Padding="4,0" Margin="6,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                            Click="MoveUp_Click" Tag="{Binding}"
                                            ToolTip="Move up" />
                                    <Button Content="↓" FontSize="10" Padding="4,0" Margin="2,0,0,0"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                            Click="MoveDown_Click" Tag="{Binding}"
                                            ToolTip="Move down" />
                                    <Button Content="✕" FontSize="10" Padding="4,0" Margin="2,0,0,0"
                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                            Click="DeleteNode_Click" Tag="{Binding}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Style>
                            <Style TargetType="TreeView">
                                <Setter Property="ItemsSource" Value="{Binding RootNodes}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditingConfigRegion}" Value="True">
                                        <Setter Property="ItemsSource" Value="{Binding ConfigNodes}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Properties + events + states -->
            <Border Grid.Column="4" Style="{StaticResource LiquidCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Properties" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel DataContext="{Binding SelectedNode, FallbackValue={x:Null}}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Key" FontSize="11.5" />
                            <ui:TextBox Text="{Binding Key, Mode=TwoWay}" />
                            <TextBlock Text="Text" FontSize="11.5" Margin="0,8,0,0" />
                            <ui:TextBox Text="{Binding Text, Mode=TwoWay}" />
                            <TextBlock Text="Size (0-1)" FontSize="11.5" Margin="0,8,0,0" />
                            <ui:TextBox Text="{Binding Size, Mode=TwoWay}" />
                            <TextBlock Text="Background" FontSize="11.5" Margin="0,8,0,0" />
                            <ui:TextBox Text="{Binding Background, Mode=TwoWay}" />
                            <TextBlock Text="{Binding NodeType}" FontSize="11.5"
                                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}" Margin="0,10,0,0" />

                            <Separator Margin="0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Events" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Content="Add event" Margin="10,0,0,0" Padding="8,2"
                                           Command="{Binding DataContext.AddNodeEventCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Events}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding DataContext.EventNames, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding EventName}" FontSize="11.5" />
                                            <ComboBox Grid.Column="1" Margin="4,0"
                                                      ItemsSource="{Binding DataContext.HandlerKinds, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding HandlerKind}" FontSize="11.5" />
                                            <ui:TextBox Grid.Column="2" Margin="4,0" Text="{Binding Detail, Mode=TwoWay}" PlaceholderText="detail" FontSize="11.5" />
                                            <ui:Button Grid.Column="3" Content="✕" Padding="4,0"
                                                       Command="{Binding DataContext.RemoveNodeEventCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Button states" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Content="Add state" Margin="10,0,0,0" Padding="8,2"
                                           Command="{Binding DataContext.AddButtonStateCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding States}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" FontSize="11.5" />
                                            <ui:TextBox Grid.Column="1" Margin="4,0" Text="{Binding Background, Mode=TwoWay}" PlaceholderText="#color" FontSize="11.5" />
                                            <ui:TextBox Grid.Column="2" Margin="4,0" Text="{Binding Text, Mode=TwoWay}" PlaceholderText="Text" FontSize="11.5" />
                                            <ui:Button Grid.Column="3" Content="✕" Padding="4,0"
                                                       Command="{Binding DataContext.RemoveButtonStateCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </ScrollViewer>
            </Border>

            <!-- JSON Schema builder -->
            <Border Grid.Column="6" Style="{StaticResource LiquidCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Data schema" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button Content="Add property" Margin="10,0,0,0" Padding="8,2"
                                   Command="{Binding AddSchemaPropertyCommand}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SchemaProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Liquid.AccentWashBrush}" CornerRadius="6" Padding="8" Margin="0,3">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="property" FontSize="11.5" />
                                                <ComboBox Grid.Column="1" Margin="6,0" FontSize="11.5"
                                                          ItemsSource="{Binding DataContext.SchemaTypes, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          SelectedItem="{Binding SchemaType}" />
                                                <CheckBox Grid.Column="2" Content="req" IsChecked="{Binding Required}" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,6,0" />
                                                <ui:Button Grid.Column="3" Content="✕" Padding="4,0"
                                                           Command="{Binding DataContext.RemoveSchemaPropertyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="Title (optional)" FontSize="11.5" />
                                                <ui:TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding DefaultValue, Mode=TwoWay}" PlaceholderText="Default" FontSize="11.5" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Preview + generate -->
            <Grid Grid.Column="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource LiquidCard}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Tile preview" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Border Width="144" Height="144" CornerRadius="14"
                                Background="#1A1C22" BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Left" ClipToBounds="True">
                            <wv2:WebView2 x:Name="Preview" DefaultBackgroundColor="Transparent" />
                        </Border>
                    </DockPanel>
                </Border>
                <ui:Button Grid.Row="2" Content="Generate widget provider" Appearance="Primary"
                           Margin="0,10,0,0" HorizontalAlignment="Stretch"
                           Command="{Binding GenerateCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
