<Page x:Class="DeckForge.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:themes="clr-namespace:DeckForge.App.Themes"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="40,24,40,40">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />

            <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" />
            <Border Style="{StaticResource LiquidCard}">
                <StackPanel>
                    <TextBlock Text="Theme" FontSize="13" FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="ThemeSystem" Content="System" Tag="System" Margin="0,0,12,0"
                                     GroupName="Theme" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeLight" Content="Light" Tag="Light" Margin="0,0,12,0"
                                     GroupName="Theme" Checked="Theme_Checked" />
                        <RadioButton x:Name="ThemeDark" Content="Dark" Tag="Dark" Margin="0,0,12,0"
                                     GroupName="Theme" Checked="Theme_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="ResolvedTheme" FontSize="12"
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" Margin="0,6,0,0" />

                    <TextBlock Text="Accent" FontSize="13" FontWeight="Medium" Margin="0,16,0,0" />
                    <ItemsControl x:Name="AccentList" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="38" Height="38" Margin="0,0,8,0"
                                        Background="{Binding ColorBrush}"
                                        BorderBrush="{DynamicResource Liquid.BorderBrush}"
                                        BorderThickness="1"
                                        Click="Accent_Click"
                                        ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="10"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AccentName" FontSize="12"
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" />
            <Border Style="{StaticResource LiquidCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/app-icon.png" Width="44" Height="44"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeckForge" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Version 0.1.0 - visual plugin studio for Macro Deck 3"
                                       FontSize="12" Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" Margin="0,12,0,0">
                        An independent, open tool for building plugins for
                        <Run Foreground="{DynamicResource Liquid.TextBrush}">Macro Deck 3</Run>.
                        Not affiliated with the Macro Deck project; Macro Deck is a trademark of its owner.
                        Plugin templates are derived from the official Apache-2.0 plugin template.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Macro Deck docs" Click="Docs_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Macro Deck site" Click="Site_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Open crash log folder" Click="CrashLog_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Check for updates" Click="CheckUpdates_Click" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" Margin="0,8,0,0" />
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"
                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}">
                        Packaging: Velopack - installer, portable build and delta auto-updates.
                        Build releases with <Run FontFamily="Cascadia Mono, Consolas">vpk pack</Run> (see Ship page or README).
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Keyboard -->
            <TextBlock Text="Keyboard shortcuts" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8" />
            <Border Style="{StaticResource LiquidCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Liquid.AccentStrongBrush}">Ctrl+N</TextBlock>
                    <TextBlock Grid.Column="1" FontSize="12.5">New plugin</TextBlock>
                    <TextBlock Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Liquid.AccentStrongBrush}">Ctrl+B</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5">Build workspace</TextBlock>
                    <TextBlock Grid.Row="2" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Liquid.AccentStrongBrush}">F5</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12.5">Run against stub host</TextBlock>
                    <TextBlock Grid.Row="3" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Liquid.AccentStrongBrush}">Ctrl+T</TextBlock>
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12.5">Focus terminal</TextBlock>
                    <TextBlock Grid.Row="4" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Liquid.AccentStrongBrush}">Ctrl+1..9</TextBlock>
                    <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12.5">Jump between pages</TextBlock>
                    <TextBlock Grid.Row="5" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Liquid.AccentStrongBrush}">Ctrl+,</TextBlock>
                    <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12.5">Open settings</TextBlock>
                    <TextBlock Grid.Row="6" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource Liquid.AccentStrongBrush}">F1</TextBlock>
                    <TextBlock Grid.Row="6" Grid.Column="1" FontSize="12.5">Open docs</TextBlock>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
