<Page x:Class="DeckForge.App.Pages.ActionsEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Actions editor" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Design an action's parameters visually, then generate a real IActionDefinition class with localized labels and integration registration."
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Docs → Actions" Icon="{ui:SymbolIcon Book24}"
                           VerticalAlignment="Top" Margin="16,0,0,0"
                           Click="OpenDocs_Click" ToolTip="Open the Macro Deck actions documentation" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{DynamicResource Liquid.AccentStrongBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Identity + generate -->
            <Border Grid.Column="0" Style="{StaticResource LiquidCard}">
                <StackPanel>
                    <TextBlock Text="Action" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Id (kebab-case, permanent)" FontSize="12" />
                    <ui:TextBox Text="{Binding ActionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Name" FontSize="12" Margin="0,10,0,0" />
                    <ui:TextBox Text="{Binding ActionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Description" FontSize="12" Margin="0,10,0,0" />
                    <ui:TextBox Text="{Binding ActionDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />
                    <ui:Button Content="Generate action" Appearance="Primary" Margin="0,14,0,0"
                               HorizontalAlignment="Left" Command="{Binding GenerateCommand}" />
                </StackPanel>
            </Border>

            <!-- Parameters -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Parameters" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ui:Button Content="Add parameter" Margin="12,0,0,0" Command="{Binding AddParameterCommand}" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Parameters}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Liquid.AccentWashBrush}"
                                    CornerRadius="8" Padding="10" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        Two wrapping lines instead of one five-column row.

                                        The row was 110+110+150+90 of fixed columns before it reached a
                                        single star column, so it needed 460px before the default value
                                        got any space at all, and it was clipped from there down. Proportional
                                        columns with MinWidths let it compress, and the second line gives
                                        the label and default somewhere to go when it does.
                                    -->
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" MinWidth="90" />
                                                <ColumnDefinition Width="1*" MinWidth="80" />
                                                <ColumnDefinition Width="*" MinWidth="90" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="name" />
                                            <ComboBox Grid.Column="1" Margin="6,0"
                                                      ItemsSource="{Binding DataContext.EditorTypes, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding EditorType, Mode=TwoWay}" />
                                            <CheckBox Grid.Column="2" Content="Required" Margin="8,0,0,0"
                                                      IsChecked="{Binding Required}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="100" />
                                                <ColumnDefinition Width="*" MinWidth="100" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding Label, Mode=TwoWay}" PlaceholderText="Label" />
                                            <ui:TextBox Grid.Column="1" Margin="6,0,0,0"
                                                       Text="{Binding DefaultValue, Mode=TwoWay}"
                                                       PlaceholderText="Default (optional)" />
                                        </Grid>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="✕" Padding="6,2" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Page>
