<Page x:Class="DeckForge.App.Pages.CapabilitiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1150" Margin="40,24,40,40">
            <TextBlock Text="Capabilities" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Everything a Macro Deck 3 plugin can offer. Add to plugin scaffolds the interface, example members and permissions into the open plugin; Docs opens the official page."
                       Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,8" />
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{DynamicResource Liquid.AccentStrongBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LiquidCard}"
                                                Width="330" Margin="0,0,12,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Grid20" FontSize="18"
                                                                   Foreground="{DynamicResource Liquid.AccentStrongBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="14" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}"
                                                           Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                                           FontSize="12.5" TextWrapping="Wrap"
                                                           Margin="0,8,0,8" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Liquid.TextTertiaryBrush}">
                                                    <Run Text="{Binding Interface, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                                                           Text="{Binding Permissions}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,10" />
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Content="Add to plugin" Appearance="Primary"
                                                               Padding="10,4" Margin="0,0,8,0"
                                                               Click="Scaffold_Click"
                                                               IsEnabled="{Binding DataContext.HasWorkspace, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               ToolTip="Scaffold this capability into the open plugin (where supported)" />
                                                    <ui:Button Content="Docs" Padding="10,4" Click="Docs_Click"
                                                               ToolTip="{Binding DocsUrl}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
