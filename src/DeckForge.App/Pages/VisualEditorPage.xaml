<Page x:Class="DeckForge.App.Pages.VisualEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:blocks="clr-namespace:DeckForge.App.Controls.Blocks"
      xmlns:conv="clr-namespace:DeckForge.App.Converters">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="TrueVisible" />
        <conv:BoolToInverseVisibilityConverter x:Key="TrueHidden" />

        <!--
            Visible only when the bound string has something in it. Needed because the slot rows' Problem is
            null most of the time, and a converter that cannot tell null from "" shows an empty gap under
            every row.
        -->
        <conv:StringToVisibilityConverter x:Key="HasTextVisible" />

        <!--
            One diagnostic row, as a template rather than markup written out in both places it is needed.

            It was written out twice - once for the no-selection pane and once inside the editors' scroll
            region - and the two copies had already drifted: one had a severity dot and the other did not.
            That is the whole argument for a resource, and the argument only works if the two uses really
            do share it, which is why both are ItemsControls naming this rather than one being a template
            of the other.

            The row is a Button so Part 9.7's "click a diagnostic to select and centre the block" works,
            and the command is resolved from the page so the row needs no reference to the view model.
        -->
        <DataTemplate x:Key="DiagnosticRow">
            <Grid Margin="0,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                        VerticalAlignment="Top" Margin="0,5,8,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Liquid.TextTertiaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource Liquid.WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource Liquid.DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Button Grid.Column="1" HorizontalContentAlignment="Stretch"
                        Background="Transparent" BorderThickness="0"
                        Padding="4,4" Cursor="Hand"
                        Command="{Binding DataContext.SelectDiagnosticCommand,
                            RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}">
                    <StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   FontSize="11.5" TextAlignment="Left" />
                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,2,0,0" TextAlignment="Left"
                                   Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

        <Grid x:Name="Layout" Margin="20,16,20,16">
            <!--
                The four panels' rows and columns are assigned in code, not here, because they change with
                the window width. At the application's minimum width the four columns do not fit beside
                each other, and a page with no horizontal scrolling does not push its right-hand content
                off the edge — it hides it, and the diagnostics pane with it. Part 9.2 asks for every
                panel to collapse; this is that, as a breakpoint rather than as four little toggle
                buttons.
            -->
            <Grid x:Name="HeaderRow" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="Header">
                    <TextBlock Text="Visual" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Drag blocks into a script, or out of one. Alt narrows a stack drag to the block under the pointer; Ctrl+Z takes a whole gesture back."
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                    <TextBlock Text="Nothing needs a mouse: arrows walk the stack, Ctrl+arrows move a block, Space picks it up, Tab and the arrows choose where it goes, Enter drops it, Escape puts it back."
                               TextWrapping="Wrap" Margin="0,2,0,0" FontSize="11.5"
                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                    <TextBlock Text="{Binding DocumentLine}" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />

                    <!--
                        The file line. Whether there is anywhere to save to and whether what is on screen is
                        what is on disk, both in the header where the design puts the honesty note. It is a
                        sentence rather than a dot because "unsaved" with no file name beside it leaves the
                        user guessing which file, and a canvas is the thing they are most likely to lose work
                        in.
                    -->
                    <TextBlock Text="{Binding FileLine}" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />

                    <!--
                        The refusal line. A drop that is not allowed is a thing a user does constantly while
                        learning which shapes fit where, and the design's own answer is that the indicator
                        simply does not appear. Saying why once, quietly, is what teaches the rule; an
                        error dialog for every mistyped drop would teach it and then get in the way.
                    -->
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource Liquid.WarningBrush}"
                               Visibility="{Binding HasMessage, Converter={StaticResource TrueVisible}}" />

                    <!--
                        The carrying line. A keyboard drag mode with no visible state is indistinguishable
                        from the editor having swallowed a keystroke, and the first thing anyone would do is
                        press Escape - which works, but only if they guessed it.
                    -->
                    <TextBlock Text="{Binding CarryingLine}" TextWrapping="Wrap" FontSize="11.5"
                               Margin="0,4,0,0" Foreground="{DynamicResource Liquid.AccentBrush}"
                               Visibility="{Binding IsCarryingLine, Converter={StaticResource TrueVisible}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <ui:Button Content="Undo" Padding="10,4" Click="Undo_Click"
                               IsEnabled="{Binding CanUndo}" ToolTip="{Binding UndoLabel}" />
                    <ui:Button Content="Redo" Padding="10,4" Margin="8,0,0,0" Click="Redo_Click"
                               IsEnabled="{Binding CanRedo}" ToolTip="{Binding RedoLabel}" />

                    <!--
                        Save and Revert, before Undo, because they are the two that decide whether the work
                        survives leaving the page. Both are disabled rather than hidden when they do
                        nothing: Revert with nothing to revert to would discard a canvas the user can only
                        get back by redoing every gesture, and Save with no workspace open would have
                        nowhere to write and no honest success to report.
                    -->
                    <ui:Button Content="Save" Padding="10,4" Margin="8,0,0,0" Click="Save_Click"
                               IsEnabled="{Binding CanSave}"
                               ToolTip="Write the canvas to the workspace's .deckforge/canvas.json" />
                    <ui:Button Content="Revert" Padding="10,4" Margin="8,0,0,0" Click="Revert_Click"
                               IsEnabled="{Binding HasWorkspace}"
                               ToolTip="Discard the canvas on screen and read the saved file back" />
                    <ui:Button x:Name="DocsButton" Content="Docs" Padding="10,4" Margin="8,0,0,0"
                               Click="OpenDocs_Click" ToolTip="Open the documentation for actions" />
                </StackPanel>
            </Grid>

            <Border x:Name="RailPanel" CornerRadius="12" Margin="0,0,10,0"
                    Background="{DynamicResource Liquid.BlockRailBrush}"
                    BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1">
                <blocks:CategoryRail DataContext="{Binding Palette}" />
            </Border>

            <Border x:Name="PalettePanel" CornerRadius="12" Margin="0,0,10,0"
                    Background="{DynamicResource Liquid.AcrylicBrush}"
                    BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1">
                <blocks:PaletteList DataContext="{Binding Palette}" />
            </Border>

            <Border x:Name="CanvasPanel" CornerRadius="12"
                    BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        The zoom row, above the canvas rather than in the header.

                        In the header it would be a fourth thing between the title and the panels, and the
                        title is the one line that explains what the page is. Beside the canvas it is next
                        to the thing it changes and out of the way when nobody is looking at the canvas.
                    -->
                    <Grid Grid.Row="0" Margin="10,8,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Zoom" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Canvas.ZoomText}" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center" MinWidth="42"
                                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                            <ui:Button Content="−" Padding="8,3" Margin="8,0,0,0"
                                       Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+wheel down)" />
                            <ui:Button Content="+" Padding="8,3" Margin="6,0,0,0"
                                       Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+wheel up)" />
                            <ui:Button Content="Fit" Padding="10,3" Margin="6,0,0,0"
                                       Click="ZoomFit_Click" ToolTip="Show the whole document" />
                            <ui:Button Content="100%" Padding="10,3" Margin="6,0,0,0"
                                       Click="ZoomActual_Click" ToolTip="Back to actual size" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="10.5" Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                                   Text="Ctrl+wheel zooms about the pointer; middle-drag pans." />
                    </Grid>

                    <Grid Grid.Row="1">
                        <blocks:BlockWorkspace x:Name="Workspace" />

                        <!--
                            The minimap, over the canvas's bottom-right corner.

                            Over rather than beside: a fifth column for a 240-pixel thumbnail would take the
                            width from the canvas, which is the one panel with none to spare, and the map is
                            only useful while the canvas is being looked at.
                        -->
                        <blocks:CanvasMinimap x:Name="Minimap" DataContext="{Binding Canvas}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Margin="0,0,12,12" ViewRequested="Minimap_ViewRequested" />
                    </Grid>
                </Grid>
            </Border>

            <!--
                The stage, across the full width under the four panels rather than as a fifth column.

                A fifth column would have taken 300 pixels off the canvas, which is the one panel here with
                no spare room, and the trace is the part that needs horizontal space to be readable at all.
                Underneath, it also gets the whole window width for the four columns the design draws - deck,
                watch, trace and parameters - which is what makes the trace timeline a timeline.
            -->
            <Border x:Name="StagePanel" CornerRadius="12" Margin="0,10,0,0"
                    Background="{DynamicResource Liquid.AcrylicBrush}"
                    BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1">
                <blocks:StagePanel DataContext="{Binding Stage}" />
            </Border>

            <!--
                The command palette and the shortcut sheet, over everything, and hidden by default.

                They are in the page's own grid rather than a window so they cover the page instead of the
                desktop: a sheet about this page's keys has to sit on the page it is describing, and a modal
                window would also be a second thing to close.
            -->
            <blocks:CommandPalette x:Name="PaletteOverlay" Grid.RowSpan="4" Grid.ColumnSpan="4"
                                   Visibility="Collapsed"
                                   CommandChosen="Palette_CommandChosen"
                                   Dismissed="Palette_Dismissed" />

            <blocks:ShortcutSheet x:Name="ShortcutOverlay" Grid.RowSpan="4" Grid.ColumnSpan="4"
                                  Visibility="Collapsed"
                                  Closed="Shortcut_Closed" />

            <Border x:Name="InspectorPanel" CornerRadius="12" Padding="0"
                    Background="{DynamicResource Liquid.AcrylicBrush}"
                    BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <!--
                            Three rows, not two. The header and the block's own summary are a fixed height,
                            and the editors and the diagnostics share what is left between them - one
                            scrolling region, because two scroll viewers in a 300-pixel column means one of
                            them is always a few pixels too tall to reach its own last row.
                        -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Selected block" Margin="12,12,12,0"
                               FontSize="13" FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1" Margin="12,6,12,8">
                        <TextBlock Text="Nothing selected. Click a block to see what it does."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource TrueHidden}}" />
                        <StackPanel DataContext="{Binding Selected}"
                                    Visibility="{Binding HasSelection, Converter={StaticResource TrueVisible}}">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12.5"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Kind}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                            <TextBlock Text="{Binding Sdk}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />

                        <!--
                            The one-block preview, quoted from the catalogue row and labelled "Emits" rather
                            than "Generated". Emitting a single block properly needs a whole action around
                            it - a signature, a body, the host guard - so this shows the row's own
                            expression. Calling it "generated" would promise it is what Save writes, and it is
                            not; the pane at the bottom of this panel is the one that can make that claim.
                        -->
                            <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="6"
                                    Background="{DynamicResource Liquid.BlockRailBrush}">
                                <StackPanel>
                                    <TextBlock Text="Row expression" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding Inspector.SelectedPreview}" TextWrapping="Wrap" FontSize="10.5"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                        <!--
                            A grid rather than a horizontal StackPanel: a stacking panel measures its
                            children with infinite width, so the wrapped summary has nothing to wrap to
                            and its tail is cut off in a narrow window.
                        -->
                        <Grid Margin="12,0,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Block" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="8,2,0,0" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                        </Grid>

                        <!--
                            The editors, between the header and the diagnostics.

                            A grid rather than a StackPanel because the rows are two columns and a label
                            that is one word must not push the editor to a different width from the row
                            below it - which is what happens the moment two labels differ in length and the
                            label column is sized to content.
                        -->
                        <!--
                            The generated C# pane, labelled as what Save writes and read-only.

                            Collapsed rather than shown-empty when there is nothing: an empty pane labelled
                            "this is what Save writes" reads as "Save writes nothing", which is a different
                            and much worse thing to believe.
                        -->
                        <!--
                            Below the editors, not above them. The editors are what a user came to the
                            inspector for, and a collapsed expander sitting above them pushes the first row
                            down by its own height for a pane almost nobody opens — which reads as the panel
                            being mislaid.
                        -->
                        <Expander Grid.Row="2" Margin="8,10,8,0" Header="Generated C#"
                                  Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                  IsExpanded="False"
                                  Visibility="{Binding Inspector.HasGeneratedCode, Converter={StaticResource TrueVisible}}">
                            <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="6"
                                    Background="{DynamicResource Liquid.BlockRailBrush}">
                                <StackPanel>
                                    <TextBlock Text="This is what Save writes. Anything outside the markers is yours."
                                               TextWrapping="Wrap" FontSize="9.5" Margin="0,0,0,5"
                                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                                    <TextBox Text="{Binding Inspector.GeneratedCode, Mode=OneWay}"
                                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                             VerticalScrollBarVisibility="Auto" MaxHeight="220" />
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!--
                            My Blocks: the definition of the procedure selected in the strip.

                            Above the slot editors and collapsed, because Part 7.14's `define {name}` carries
                            its parameters as slots and a block's slot count is fixed when the block is made.
                            The declaration's parameter list can change while a user is still deciding what
                            the procedure is for, so the parameters live here and the call blocks take their
                            arity from the declaration. The body is a column on the canvas, not a field here:
                            it is a stack of blocks, and it is edited with the same gestures as any other.

                            Its own row rather than the first thing in the scrolling region, so that opening
                            it does not push the block editors - what somebody clicks a block for - down the
                            panel.
                        -->
                        <Expander Grid.Row="0" Margin="8,0,8,0" Header="My Blocks"
                                  Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                                  HorizontalAlignment="Stretch"
                                  Visibility="{Binding HasSelectedProcedure, Converter={StaticResource TrueVisible}}"
                                  IsExpanded="True">
                            <!--
                                Open rather than collapsed, and statically: an Expander binds IsExpanded
                                two-way by default, and pointing it at a read-only property throws an
                                InvalidOperationException the moment the panel is built - which the crash
                                handler swallows, so the page comes up looking almost right with an empty
                                canvas. OneTime would also silence it, but the honest reading of "open when
                                a procedure is selected" is one line of markup rather than a settable
                                property nobody sets.
                            -->
                            <StackPanel x:Name="ProcedurePanel" Margin="0,6,0,0"
                                        DataContext="{Binding SelectedProcedure}">

                                <TextBlock Text="Name" FontSize="10.5"
                                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                                <TextBox x:Name="ProcedureNameBox" Tag="{Binding}" FontSize="12"
                                         Text="{Binding Header, Mode=OneWay}"
                                         LostFocus="ProcedureName_LostFocus" KeyDown="ProcedureName_KeyDown" />

                                <CheckBox x:Name="ReturnsBox" Tag="{Binding}" Margin="0,6,0,0"
                                          Content="Returns a value"
                                          Checked="Returns_Changed" Unchecked="Returns_Changed"
                                          IsChecked="{Binding Procedure.Returns, Mode=OneWay}" />

                                <TextBlock Text="Parameters" FontSize="10.5" Margin="0,8,0,2"
                                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />

                                <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                No Tag on these two controls, and that is the point. The
                                                panel only ever shows the selected procedure, so the
                                                handler reads it from the editor rather than being told
                                                it twice - and being told it twice was what broke: the row
                                                lives in a DataTemplate, where neither ElementName nor an
                                                ancestor search can see the panel's DataContext, so the
                                                button looked wired and did nothing.
                                            -->
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=OneWay}"
                                                         FontSize="11.5"
                                                         LostFocus="Parameter_LostFocus" />
                                                <ui:Button Grid.Column="1" Content="×" MinWidth="26" MinHeight="24" Margin="4,0,0,0"
                                                           FontSize="13" Click="ParameterRemove_Click"
                                                           ToolTip="Remove this parameter" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Takes no parameters — call it with the plain call block."
                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                                           Visibility="{Binding IsCallableAsBareCall, Converter={StaticResource TrueVisible}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ui:Button Content="+ Parameter" Padding="8,2" FontSize="11"
                                               Tag="{Binding}"
                                               Click="ParameterAdd_Click" />
                                    <ui:Button Content="Delete procedure" Padding="8,2" Margin="8,0,0,0"
                                               FontSize="11" Tag="{Binding}"
                                               Click="ProcedureDelete_Click"
                                               ToolTip="Remove the procedure. Calls to it will be reported as missing." />
                                </StackPanel>

                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="10.5"
                                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                                           Text="Its body is the column on the canvas. Drag blocks into it the same way you would into a script." />
                            </StackPanel>
                        </Expander>

                        <Grid Grid.Row="1" Margin="12,0,12,8"
                              Visibility="{Binding HasSelection, Converter={StaticResource TrueVisible}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--
                                The editors and the diagnostics in one scrolling region. They were separate
                                scroll viewers until the generated-code pane arrived, which put three
                                independently scrolling regions into a 300-pixel column; the middle one was
                                unusable, and a panel whose own sections cannot both be reached is a panel
                                nobody uses.
                            -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
                                <StackPanel>
                                    <!--
                                        The comment, above the slot editors.

                                        Above them because a comment is about the block, while every row
                                        below is about one hole in it - and a note that sits at the bottom
                                        of a scrolling panel is a note nobody finds. Bound with a
                                        lost-focus commit rather than per keystroke, because a comment is a
                                        sentence and the editor coalesces the keystrokes anyway.
                                    -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Comment" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Inspector.CommentHelp}" TextWrapping="Wrap"
                                                   FontSize="9.5" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                                        <TextBox Text="{Binding Inspector.Comment, UpdateSourceTrigger=LostFocus}"
                                                 FontSize="11.5" Padding="6,4" Margin="0,4,0,0"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                                                 ToolTip="Saved with the canvas, and carried into the generated code as a comment." />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Inspector.Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <!--
                                                            Star, not Auto with a minimum. An Auto column
                                                            sizes itself to the widest label in the stack
                                                            above it too, so one long label reflows every
                                                            editor in the panel and the fields stop lining up
                                                            - which is the whole reason this is a grid rather
                                                            than a StackPanel per row.
                                                        -->
                                                        <ColumnDefinition Width="*" MinWidth="80" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Help}" FontSize="9.5"
                                                                   TextWrapping="Wrap" Margin="0,1,0,0"
                                                                   Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <!--
                                                            One text field for every type, with the
                                                            affordances for that type beneath it. Part 9.6 asks
                                                            for a spinner on numbers and a toggle on
                                                            booleans, and both are a text field with a
                                                            knob: the alternative is three controls per row
                                                            in markup and three of them drawn on every row
                                                            whether they apply or not. Binding the toggle's
                                                            content to Text rather than to the block also
                                                            keeps it truthful — a toggle that is not bound
                                                            to the value shows whatever was last rendered,
                                                            which after a rebuild is nothing.
                                                        -->
                                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="11.5" Padding="6,3"
                                                                 ToolTip="{Binding Name}" />
                                                        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"
                                                                   FontSize="10" Margin="2,2,0,0"
                                                                   Foreground="{DynamicResource Liquid.WarningBrush}"
                                                                   Visibility="{Binding Problem, Converter={StaticResource HasTextVisible}}" />
                                                        <TextBlock Text="{Binding ChildLabel}" TextWrapping="Wrap"
                                                                   FontSize="10" Margin="2,2,0,0"
                                                                   Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                                                                   Visibility="{Binding HasChild, Converter={StaticResource TrueVisible}}" />

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                    Visibility="{Binding IsNumber, Converter={StaticResource TrueVisible}}">
                                                            <ui:Button Content="−" Padding="8,2" Click="Slot_Decrement"
                                                                      Tag="{Binding}" />
                                                            <TextBlock Text="{Binding Number}" Margin="10,0"
                                                                       VerticalAlignment="Center" FontSize="11.5" />
                                                            <ui:Button Content="+" Padding="8,2" Click="Slot_Increment"
                                                                      Tag="{Binding}" />
                                                        </StackPanel>

                                                        <CheckBox Margin="0,4,0,0" Content="true"
                                                                  IsChecked="{Binding Boolean, Mode=OneWay}"
                                                                  Click="Slot_Toggle" Tag="{Binding}"
                                                                  Visibility="{Binding IsBoolean, Converter={StaticResource TrueVisible}}" />

                                                        <ui:Button Content="Clear" Padding="8,2" Margin="0,4,0,0"
                                                                   HorizontalAlignment="Left" Click="Slot_Clear"
                                                                   Tag="{Binding}"
                                                                   Visibility="{Binding CanClear, Converter={StaticResource TrueVisible}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Inspector.Menus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="92" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Selected}"
                                                              FontSize="11.5" Padding="6,3" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="This block has nothing to fill in." TextWrapping="Wrap"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                                               Visibility="{Binding Inspector.IsPlain, Converter={StaticResource TrueVisible}}" />

                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Diagnostics" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource DiagnosticRow}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--
                            Without a selection the diagnostics are the only thing the panel has to say, so
                            they get the whole area and a heading of their own rather than a collapsed
                            section under an empty editor.
                        -->
                        <StackPanel Grid.Row="1" Margin="12,0,12,8"
                                    Visibility="{Binding HasSelection, Converter={StaticResource TrueHidden}}">
                            <TextBlock Text="Diagnostics" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <ItemsControl ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource DiagnosticRow}" Margin="0,4,0,0" />
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
</Page>