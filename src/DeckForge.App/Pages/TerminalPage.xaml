<Page x:Class="DeckForge.App.Pages.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Terminal" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Cwd}"
                               Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Docs → CLI reference" Icon="{ui:SymbolIcon Book24}"
                           VerticalAlignment="Top" Click="OpenDocs_Click"
                           ToolTip="Open the macrodeck-plugin CLI documentation" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#12000000"
                BorderBrush="{DynamicResource Liquid.BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <ListBox x:Name="OutputList"
                     ItemsSource="{Binding Lines}"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12.5"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Liquid.AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Liquid.DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="PS&gt;" FontFamily="Cascadia Mono, Consolas"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource Liquid.AccentBrush}" />
            <ui:TextBox Grid.Column="1" x:Name="CommandInput"
                        PlaceholderText="dotnet build | macrodeck-plugin run --stub-host | gh release create ..."
                        Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="CommandInput_KeyDown" />
            <ui:Button Grid.Column="2" Content="Run" Appearance="Primary" Margin="8,0,0,0"
                       Command="{Binding RunCommand}" />
            <ui:Button Grid.Column="3" Content="Cancel" Margin="8,0,0,0"
                       Command="{Binding Operation.CancelCommand}"
                       ToolTip="Stop the process this console started." />
        </Grid>
    </Grid>
</Page>
