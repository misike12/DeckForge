<UserControl x:Class="DeckForge.App.Controls.Blocks.CanvasMinimap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DeckForge.App.Converters"
             xmlns:visual="clr-namespace:DeckForge.App.ViewModels.Visual"
             Background="Transparent"
             Focusable="False">

    <!--
        The minimap: the whole document drawn small, with the visible part outlined.

        Drawn from Core's `Minimap`, so the rectangles here are the same arithmetic the canvas and the drop
        resolver use. A minimap that drew its own approximation would drift from the canvas the first time
        either changed, and a thumbnail that lies is worse than no thumbnail.

        Clicking it moves the viewport. A map that only shows where you are is a picture; one you can click
        is a scrollbar with a map on it, which is the point of putting it beside a canvas wider than the
        window.
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="TrueVisible" />
    </UserControl.Resources>

    <Border CornerRadius="8" Padding="6"
            Background="{DynamicResource Liquid.AcrylicBrush}"
            BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1">
        <!--
            Clipped, and it has to be. A Canvas does not clip its own children, so a rectangle placed
            outside the 240 by 150 box paints straight over the canvas next to it - which is what driving
            the window showed: the map's own blocks, drawn in full size across half the editor, with the
            map itself empty. The map is the box; anything outside the box is not part of it.
        -->
        <Grid Width="240" Height="150" ClipToBounds="True">
            <Canvas x:Name="Map" Background="Transparent" MouseLeftButtonDown="Map_Click" />

            <TextBlock Text="Nothing on the canvas yet"
                       FontSize="10.5" TextWrapping="Wrap" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                       Visibility="{Binding HasNothing, Converter={StaticResource TrueVisible}}" />
        </Grid>
    </Border>
</UserControl>