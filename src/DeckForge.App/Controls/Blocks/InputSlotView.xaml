<UserControl x:Class="DeckForge.App.Controls.Blocks.InputSlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blocks="clr-namespace:DeckForge.App.Controls.Blocks"
             xmlns:conv="clr-namespace:DeckForge.App.Converters"
             Background="Transparent"
             Focusable="False"
             UseLayoutRounding="True">

    <!--
        The hole in a block's label.

        Two states, as Part 9.4 describes: a field with a value in it, or a host for a nested reporter
        tile. Which one is decided by the model, not by the markup — a hole that decides for itself
        whether it holds a value or a block is a hole whose editor and the inspector can disagree about
        what is in it.
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="TrueVisible" />
        <conv:BoolToInverseVisibilityConverter x:Key="TrueHidden" />
    </UserControl.Resources>

    <Grid Margin="2,0"
          DataContext="{Binding Data, RelativeSource={RelativeSource AncestorType={x:Type blocks:InputSlotView}}}">
        <Border x:Name="Field"
                CornerRadius="11"
                MinWidth="26"
                Height="24"
                Padding="8,0"
                Background="{DynamicResource Liquid.BlockSlotBrush}"
                BorderBrush="{DynamicResource Liquid.BlockSlotStrokeBrush}"
                BorderThickness="1"
                Visibility="{Binding HasChild, Converter={StaticResource TrueHidden}}">
            <TextBlock Text="{Binding Display}"
                       FontFamily="{DynamicResource Liquid.FontFamily}"
                       FontSize="12.5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="220"
                       ToolTip="{Binding ToolTipText}"
                       Foreground="{Binding Ink, RelativeSource={RelativeSource AncestorType={x:Type blocks:BlockTile}}}" />
        </Border>

        <blocks:BlockTile DataContext="{Binding Child}"
                          Visibility="{Binding HasChild, Converter={StaticResource TrueVisible}}" />
    </Grid>
</UserControl>