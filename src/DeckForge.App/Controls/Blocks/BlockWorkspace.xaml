<UserControl x:Class="DeckForge.App.Controls.Blocks.BlockWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:blocks="clr-namespace:DeckForge.App.Controls.Blocks"
             xmlns:conv="clr-namespace:DeckForge.App.Converters"
             Background="Transparent">

    <!--
        The canvas.

        One column per script, laid out left to right with a column per script, each in its own scrollable
        area. Part 9.4 describes a ScrollViewer around a zoom ScaleTransform around a Canvas holding one
        view per script; the transform and absolute positions are Phase 10, and building them now means a
        second layout that Phase 10 has to throw away.

        The drag surface is named, and everything about the pointer is expressed in its coordinates: the
        ghost, the indicator, the hit test and the resolver's candidates. One coordinate system for all of
        them is not tidiness - it is the only way the indicator can be guaranteed to point at the block
        the ghost will join.
    -->
    <UserControl.Resources>
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />

        <!--
            Declared here rather than in the application resources because it is this template's own
            decision: a procedure column has no hat, and hiding it is part of what makes one template
            serve both kinds of column.
        -->
        <conv:BoolToVisibilityConverter x:Key="TrueVisible" />
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  Background="{DynamicResource Liquid.BlockCanvasBrush}">
        <Grid x:Name="SurfaceGrid" Background="{DynamicResource Liquid.BlockGridBrush}">

            <StackPanel Orientation="Horizontal">

                <Border Width="180" VerticalAlignment="Stretch" Padding="0,8"
                        Background="{DynamicResource Liquid.BlockRailBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18" Color="Black" />
                    </Border.Effect>
                    <blocks:ScriptStrip />
                </Border>

                <!--
                    The drag surface. Named because every pointer position in the drag code is translated
                    into this element's coordinates, and an element with no name has no stable way to be
                    referred to from code at all.

                    One column per script and per procedure. A procedure is a column rather than
                    something in a panel because its body is a stack of blocks, and a stack edited
                    through a form is a worse editor than the one next to it.

                    Width left unset rather than fixed at 1600, so the canvas measures to its columns and
                    the scroll viewer's range covers every one of them. A fixed width capped how far it
                    could scroll, and eleven scripts already needed more than that; adding procedure
                    columns made the far end of the document genuinely unreachable rather than merely
                    inconvenient. The minimum keeps a near-empty document from being a cramped strip.
                    Every drag calculation uses coordinates relative to this element's origin, so growing it
                    moves nothing that depends on them.

                    The hat tile is bound through HasHat rather than omitted, because one template for
                    both kinds of column is the reason the hit test, the traversal and the drop
                    resolver each have one path instead of two.
                -->
                    <!--
        The zoom lives on the surface's RenderTransform and nothing else. Part 10's zoom and pan are applied
        once, here, on the way to the screen; every number Core works in is in workspace units, so a zoom
        applied anywhere else would put the drop resolver's arithmetic out by a factor the user cannot see.
    -->
    <Canvas x:Name="Surface" MinWidth="1600" Margin="16" Background="Transparent">
        <Canvas.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
            </TransformGroup>
        </Canvas.RenderTransform>
                    <ItemsControl ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="400" Margin="0,0,24,0" VerticalAlignment="Top">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{Binding AccentKey, Converter={StaticResource KeyToBrush}}" />
                                        <TextBlock Text="{Binding Header}" Margin="8,0,0,0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel>
                                        <blocks:BlockTile DataContext="{Binding Hat}"
                                                         Visibility="{Binding HasHat, Converter={StaticResource TrueVisible}}" />
                                        <ItemsControl ItemsSource="{Binding Body}" Margin="0,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <blocks:BlockTile />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
