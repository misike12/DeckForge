<UserControl x:Class="DeckForge.App.Controls.Blocks.PaletteList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:DeckForge.App.Converters"
             xmlns:blocks="clr-namespace:DeckForge.App.Controls.Blocks"
             Background="Transparent">

    <!--
        The palette: a search box over real blocks.

        Each row is the same BlockTile the canvas uses rather than a list of strings. A palette that draws
        blocks one way and the canvas another is a palette that lies about what dropping will produce, and
        the difference is only visible once a user has dropped something.
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="TrueVisible" />
        <conv:BoolToInverseVisibilityConverter x:Key="TrueHidden" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="SearchBox" Grid.Row="0"
                    PlaceholderText="Search blocks or ids"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                    Padding="8,6" Margin="8,8,8,4"
                    ToolTip="Part of a label, or a catalogue id such as control.repeat" />

        <!--
            The recency and pinned strips, above the category's blocks and only while no search is running.

            A search spans every category, so showing a strip of blocks *from* one category beside results
            from all eleven would be a row that belongs to nothing in particular. Hidden while searching is
            also the honest behaviour: the user asked for a set of blocks and got it.
        -->
        <StackPanel Grid.Row="1" Margin="10,0,10,4"
                    Visibility="{Binding IsSearching, Converter={StaticResource TrueHidden}}">
            <TextBlock Text="Recent" FontSize="10.5" Margin="2,0,0,2"
                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                       Visibility="{Binding HasRecents, Converter={StaticResource TrueVisible}}" />
            <ItemsControl ItemsSource="{Binding Recents}"
                          Visibility="{Binding HasRecents, Converter={StaticResource TrueVisible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2" Padding="4" CornerRadius="6"
                                Background="{DynamicResource Liquid.BlockRailBrush}"
                                BorderBrush="{DynamicResource Liquid.BorderBrush}" BorderThickness="1">
                            <blocks:BlockTile />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Pinned" FontSize="10.5" Margin="2,6,0,2"
                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                       Visibility="{Binding HasFavourites, Converter={StaticResource TrueVisible}}" />
            <ItemsControl ItemsSource="{Binding Favourites}"
                          Visibility="{Binding HasFavourites, Converter={StaticResource TrueVisible}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2" Padding="4" CornerRadius="6"
                                Background="{DynamicResource Liquid.BlockRailBrush}"
                                BorderBrush="{DynamicResource Liquid.AccentBrush}" BorderThickness="1">
                            <blocks:BlockTile />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,6">
            <TextBlock Text="{Binding CountText}" FontSize="11"
                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
            <TextBlock Text="Drag a block onto the canvas" Margin="10,0,0,0" FontSize="11"
                       Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                       Visibility="{Binding IsSearching, Converter={StaticResource TrueHidden}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <Grid>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="4,0,4,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3" Padding="4" CornerRadius="8" Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Liquid.AccentWashBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <blocks:BlockTile />
                                        <TextBlock Text="{Binding Summary}" Margin="2,2,2,0" FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                                    </StackPanel>

                                    <!--
                                        The pin, on the row rather than in a context menu.

                                        A context menu would be one more gesture to learn for the one
                                        thing a user does most often on a row they like, and it is invisible
                                        until it is found. The star is drawn empty, so the affordance is
                                        there before it has been used.
                                    -->
                                    <Button Grid.Column="1" Width="22" Height="22" VerticalAlignment="Top"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Cursor="Hand" Focusable="False"
                                            Click="Favourite_Click"
                                            ToolTip="Pin this block to the top of the palette">
                                        <TextBlock Text="★" FontSize="12" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Liquid.TextTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Liquid.AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding EmptyText}"
                           Margin="16" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource Liquid.TextSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource TrueVisible}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
