<UserControl x:Class="DeckForge.App.Controls.Blocks.StagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:DeckForge.App.Converters"
             xmlns:runtime="clr-namespace:DeckForge.Core.Visual.Runtime;assembly=DeckForge.Core"
             Background="Transparent">

    <!--
        The stage: a simulated host, a transport, a watch table and a trace.

        The honesty statement is the first thing in the panel and is not collapsible. Part 10.5 asks for it
        in the UI rather than only in the design, and a caveat under a disclosure triangle is a caveat the
        user has to go looking for - which is the one thing that makes a caveat not a caveat.

        Every list here is an ItemsControl over an ObservableCollection the view model rebuilt, so the panel
        itself holds no state. That is deliberate: a stage that kept its own copy of the trace is a stage
        that shows what it last heard rather than what happened.
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="TrueVisible" />
        <conv:BoolToInverseVisibilityConverter x:Key="TrueHidden" />
        <conv:StringToVisibilityConverter x:Key="HasTextVisible" />

        <!-- One traced step. The kind drives the colour so a trace reads at a glance: green for what ran,
             grey for what it read, amber for a wait, red for a problem. -->
        <DataTemplate x:Key="TraceRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="10.5" Margin="8,0,0,0"
                           MaxWidth="220" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DeckTile">
            <Border Margin="2" Padding="6,4" CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Liquid.BorderBrush}"
                    Background="{DynamicResource Liquid.AcrylicBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Liquid.BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsThePressingClient}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Liquid.AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Id}" FontSize="9.5"
                               Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        The root grid carries a transparent background so that a right-click in the gaps between the four
        columns finds something. A Grid with no background is transparent to the mouse, so without this the
        stage's menu would only open over the text and the buttons - and Part 18.5's stage menu is exactly
        the thing a user opens on empty space.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,10,12,0">
            <TextBlock Text="Stage" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding HonestyStatement}" TextWrapping="Wrap" FontSize="10.5"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource Liquid.WarningBrush}" />
        </StackPanel>

        <!--
            The transport. Run, Step, Step into, Pause, Stop and Reset, then the script picker and the speed.

            Step into is next to Step rather than hidden in a menu because the two answer different
            questions about the same script - "what does this do" and "what does this do when it loops" -
            and a user debugging a loop presses Step into forty times before they ever press Run.

            Pause is here for the same reason rather than only in the stage's context menu: Part 10.3 lists
            it in the transport, and a transport control that exists only behind a right-click is one a
            keyboard user never finds. One button whose label and F6 both toggle, because a debugger's
            transport has always shown Pause while running and Continue the moment it is not, and
            VisualCommands cannot hold two commands sharing one gesture - the rule that keeps the shortcut
            sheet honest is also what makes these one row rather than two.

            IsEnabled is CanPause rather than nothing, so the button is visible and disabled while nothing is
            running: a Pause that is merely absent is a Pause that has to be found again to be brought back,
            and a disabled one can carry a tooltip saying why.
        -->
        <WrapPanel x:Name="TransportRow" Grid.Row="1" Margin="12,8,12,0" VerticalAlignment="Center"
                   Background="Transparent">
            <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}"
                      MinWidth="240" Padding="6,3" FontSize="11.5"
                      ToolTip="Which script to run" />

            <ui:Button Content="Run" Padding="10,4" Margin="8,0,0,0"
                       Command="{Binding RunCommand}" ToolTip="Run from the top, or resume from a breakpoint (F5)" />
            <ui:Button Content="Step" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding StepCommand}" IsEnabled="{Binding CanStep}"
                       ToolTip="One block, then stop (F10)" />
            <ui:Button Content="Step into" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding StepIntoCommand}" IsEnabled="{Binding CanStep}"
                       ToolTip="One block, stopping inside a loop's body if it meets one (F11)" />
            <ui:Button Content="{Binding PauseLabel}" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}"
                       ToolTip="Suspend a running script at the next block boundary, and carry on from there (F6)" />
            <ui:Button Content="Stop" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding StopCommand}" ToolTip="Stop where it stands (Shift+F5)" />
            <ui:Button Content="Reset" Padding="10,4" Margin="6,0,0,0"
                       Command="{Binding ResetCommand}"
                       ToolTip="Clear the trace, the variables and the clock" />

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Speed" FontSize="10.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                <Slider Width="120" Minimum="1" Maximum="60" Value="{Binding Speed, Mode=TwoWay}"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="Steps a second. The budget still ends a loop that never does." />
            </StackPanel>
        </WrapPanel>

        <!--
            Three lines of state: what happened, what the clock says, and what the network is doing.

            The network line is the one that stops a false impression. A dry run that silently answered a
            request from a canned table looks exactly like one that asked the internet, and a user who
            builds a button on top of that belief has built a button that will do nothing on a deck.
        -->
        <StackPanel x:Name="StatePanel" Grid.Row="2" Margin="12,6,12,0" Background="Transparent">
            <TextBlock Text="{Binding Outcome}" FontSize="11" TextWrapping="Wrap" />
            <WrapPanel Margin="0,2,0,0">
                <TextBlock Text="{Binding ClockText}" FontSize="10"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                <TextBlock Text="{Binding NetworkText}" FontSize="10" Margin="12,0,0,0"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                <TextBlock Text="{Binding BreakpointCountText}" FontSize="10" Margin="12,0,0,0"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
            </WrapPanel>
        </StackPanel>

        <!--
            Four columns sharing the last row, so nothing is ever below the fold: the deck, the
            notifications, the watch table with the parameters, and the trace. The trace gets two of the
            widths because it is the part with the most rows and the longest lines, and a trace in a
            hundred-pixel column is a column of ellipses.
        -->
        <Grid Grid.Row="3" Margin="12,8,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Deck" FontSize="11.5" FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="Mocked from what the action declared. Nothing here talks to a real deck."
                           TextWrapping="Wrap" FontSize="9.5" Margin="0,0,0,4"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                <ItemsControl ItemsSource="{Binding Deck}" ItemTemplate="{StaticResource DeckTile}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Bottom" Text="No deck items. The action's capability list is empty."
                           TextWrapping="Wrap" FontSize="10"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                           Visibility="{Binding HasDeck, Converter={StaticResource TrueHidden}}" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Watch" FontSize="11.5" FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WatchRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Liquid.TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock DockPanel.Dock="Top" Text="Nothing watched. A watch block, or WatchVariable in the inspector, fills this."
                           TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                           Visibility="{Binding HasWatch, Converter={StaticResource TrueHidden}}" />

                <TextBlock DockPanel.Dock="Top" Text="Parameters" FontSize="11.5" FontWeight="SemiBold"
                           Margin="0,8,0,4"
                           Visibility="{Binding HasParameters, Converter={StaticResource TrueVisible}}" />
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Parameters}"
                              Visibility="{Binding HasParameters, Converter={StaticResource TrueVisible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Padding="4,2" Margin="6,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="8" Background="Transparent" />

            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Trace" FontSize="11.5" FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="What each block did, in order. The red line names the block that stopped the run."
                           TextWrapping="Wrap" FontSize="9.5" Margin="0,0,0,4"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}" />
                <ScrollViewer x:Name="TraceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ItemsControl ItemsSource="{Binding Trace}" ItemTemplate="{StaticResource TraceRow}" />
                </ScrollViewer>
                <TextBlock DockPanel.Dock="Bottom" Text="Nothing has run. Press Step to walk one block at a time."
                           TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                           Foreground="{DynamicResource Liquid.TextTertiaryBrush}"
                           Visibility="{Binding HasTrace, Converter={StaticResource TrueHidden}}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>